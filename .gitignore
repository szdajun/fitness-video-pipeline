# ═══════════════════════════════════════════════════════════
# .gitignore — 健身视频流水线
# 原则: 大文件 (视频/模型/音频) 绝不上 git; 中间产物不上 git
# ═══════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo

# ── 视频/音频 (大文件, 绝不 commit) ─────────────────────
*.mp4
*.avi
*.mov
*.mkv
*.wav
*.mp3
*.aac
*.flac

# ── 模型权重 (大文件) ───────────────────────────────────
*.pt
*.pth
*.onnx
*.tflite
*.bin
*.zip

# ── 源视频目录 (不入库) ─────────────────────────────────
source_videos/

# ── 输出目录 (中间产物 + 最终成品都不入库) ──────────────
output/

# ── 临时/中间文件 ────────────────────────────────────────
_temp/
tmp/
logs/
*.tmp
*.log
*.trf
*_keypoints.json
*_manifest.json
*_metrics.json
outputtest_*

# ── 调试图片 ─────────────────────────────────────────────
check_*.jpg
dbg_*.jpg
debug_*.png
*.py.jpg
_verify_*.png

# ── 权重/模型库 (大文件, 不在 git 管理) ─────────────────
gfpgan/
weights/
models/

# ── 虚拟环境 ─────────────────────────────────────────────
venv/

# ── 资产 (音乐/图片等二进制) ────────────────────────────
assets/*.mp3
assets/*.raw
assets/*.mp4
music_library/
music_royalty_free/
coach_portraits/

# ── 自动化状态 (运行时产生, 不入库) ─────────────────────
auto_publish*.log
auto_publish_state.json
day_counter.json
video_index.db
upload_manifest.json
publish_queue.json

# ── 系统 ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 敏感 ──────────────────────────────────────────────────
.env
*.key
*.pem
# API token: .claude/glm.json 明文存凭证, 绝不入库
.claude/glm.json